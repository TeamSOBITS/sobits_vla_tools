<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sobits_vla_deploy</name>
  <version>0.1.0</version>
  <description> ROS packages for SOBITS VLA Deploy. </description>

  <maintainer email="kvalentincardenas@gmail.com">VALENTIN Keith</maintainer>

  <license>BSD-3-Clause</license>

  <url type="website">https://home.soka.ac.jp/~choi/index.html</url>
  <url type="repository">https://github.com/TeamSOBITS/sobits_vla_tools</url>
  <url type="bugtracker">https://github.com/TeamSOBITS/sobits_vla_tools/issues</url>

  <author email="team.sobits@gmail.com">Team SOBITS</author>
  <author email="kvalentincardenas@gmail.com">VALENTIN Keith</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>sobits_interfaces</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>