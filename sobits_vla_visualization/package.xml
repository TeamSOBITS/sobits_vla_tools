<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sobits_vla_visualization</name>
  <version>0.1.0</version>
  <description>
    Research-grade analysis and plotting for SOBITS VLA evaluation episode logs
    (SmolVLA vs Pi05 comparison).
  </description>

  <maintainer email="kvalentincardenas@gmail.com">VALENTIN Keith</maintainer>

  <license>BSD-3-Clause</license>

  <url type="website">https://home.soka.ac.jp/~choi/index.html</url>
  <url type="repository">https://github.com/TeamSOBITS/sobits_vla_tools</url>
  <url type="bugtracker">https://github.com/TeamSOBITS/sobits_vla_tools/issues</url>

  <author email="team.sobits@gmail.com">Team SOBITS</author>
  <author email="kvalentincardenas@gmail.com">VALENTIN Keith</author>

  <buildtool_depend>ament_python</buildtool_depend>

  <!--
    Python (non-ROS) deps — numpy, pandas, matplotlib — are managed by pixi
    (see pixi.toml, feature.stack), NOT declared as rosdep keys. This package is
    numpy-2 based; the apt python3-numpy/pandas are numpy-1 builds and would
    ABI-clash. Run via `pixi run -e cpu ...` (or -e gpu).
  -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
