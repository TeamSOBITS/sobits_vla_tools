<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sobits_vla_rosbag_conversion</name>
  <version>0.1.0</version>
  <description> ROS packages for SOBITS VLA Rosbag Conversion. </description>

  <maintainer email="kvalentincardenas@gmail.com">VALENTIN Keith</maintainer>

  <license>BSD</license>

  <url type="website">https://home.soka.ac.jp/~choi/index.html</url>
  <url type="repository">https://github.com/TeamSOBITS/sobits_vla_tools</url>
  <url type="bugtracker">https://github.com/TeamSOBITS/sobits_vla_tools/issues</url>

  <author email="team.sobits@gmail.com">Team SOBITS</author>
  <author email="kvalentincardenas@gmail.com">VALENTIN Keith</author>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>sobits_vla_common</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <!--
    Python (non-ROS) deps — numpy, pandas, scipy, pyarrow, pyyaml, matplotlib,
    rosbags, torch, lerobot — are NOT declared as rosdep keys on purpose.
    Declaring python3-numpy/pandas/scipy here pulls apt builds pinned to
    numpy 1.x, which crash lerobot/pandas at import ("numpy.dtype size
    changed" ABI error). Those packages are managed by pixi (see pixi.toml,
    feature.conversion) and run via `pixi run -e conversion-{cpu,gpu} ...`.
    python3-opencv is kept as apt to stay ABI-matched with cv_bridge.
  -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>