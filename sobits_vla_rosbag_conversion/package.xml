<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sobits_vla_rosbag_conversion</name>
  <version>0.1.0</version>
  <description> ROS packages for SOBITS VLA Rosbag Conversion. </description>

  <maintainer email="kvalentincardenas@gmail.com">VALENTIN Keith</maintainer>

  <license>BSD</license>

  <url type="website">https://home.soka.ac.jp/~choi/index.html</url>
  <url type="repository">https://github.com/TeamSOBITS/sobits_vla_tools</url>
  <url type="bugtracker">https://github.com/TeamSOBITS/sobits_vla_tools/issues</url>

  <author email="team.sobits@gmail.com">Team SOBITS</author>
  <author email="kvalentincardenas@gmail.com">VALENTIN Keith</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pandas</exec_depend>
  <exec_depend>python3-pyarrow</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!--
    Runtime note:
    This package is typically executed with /opt/pytorch/.venv/bin/python3 where
    lerobot, rosbags, and torch are installed. Keep that environment in sync with
    the imports used in ros2bag_to_lerobotdataset.py.
  -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>